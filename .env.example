# Copia este archivo como .env y rellena DB_PASSWORD (el .env no se sube)
DB_NAME=kalma_snkrs
DB_USER=kalma
DB_PASSWORD=

# Solo si el 80/443 del servidor ya están ocupados: KALMA se publica en otros puertos
# y Nginx redirige HTTP a la dirección pública con su puerto.
# KALMA_PUERTO_HTTP=8080
# KALMA_PUERTO_HTTPS=8443
# KALMA_ORIGEN=https://kalma.local:8443
