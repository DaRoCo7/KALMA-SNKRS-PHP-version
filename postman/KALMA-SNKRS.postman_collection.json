            "body": { "mode": "raw", "raw": "{\n  \"email\": \"cliente@kalma.test\",\n  \"password\": \"Kalma2026!\"\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
