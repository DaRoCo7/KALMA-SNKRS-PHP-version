          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ] } }]
        }
      ]
    },
    {
      "name": "4. Catálogo",
      "item": [
        {
          "name": "Listado paginado (200)",
          "request": { "method": "GET", "url": "{{base_url}}/api/productos?pagina=1&por_pagina=4", "description": "GET /api/productos · Público. Parámetros: buscar, categoria, color, talla, precio_min, precio_max, personalizable, disponible, orden (novedades, precio_asc, precio_desc, nombre), pagina, por_pagina." },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const cuerpo = pm.response.json();",
            "pm.test('4 productos en la página', () => pm.expect(cuerpo.datos).to.have.lengthOf(4));",
            "pm.test('Al menos 8 productos en total', () => pm.expect(cuerpo.paginacion.total).to.be.at.least(8));",
            "pm.test('Precio, foto, color, tallas y stock', () => {",
            "    pm.expect(cuerpo.datos[0]).to.include.keys('precio', 'imagen', 'color', 'tallas_disponibles', 'stock_total');",
            "});"
          ] } }]
        },
        {
          "name": "Filtros combinados: categoría y orden (200)",
          "request": { "method": "GET", "url": "{{base_url}}/api/productos?categoria=3&orden=precio_desc" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const productos = pm.response.json().datos;",
            "pm.test('Solo la categoría 3 (Jordan)', () => productos.forEach(p => pm.expect(p.categoria.id).to.eql(3)));",
            "pm.test('Ordenados de mayor a menor precio', () => {",
