    },
    {
      "name": "5. Seguridad",
      "item": [
        {
          "name": "Token CSRF falso (403)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/logout",
            "header": [{ "key": "X-CSRF-Token", "value": "token-falso" }],
            "description": "Una petición que modifica datos sin el token de la sesión se rechaza."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
            "pm.test('Motivo: CSRF', () => pm.expect(pm.response.json().error.mensaje).to.include('CSRF'));"
          ] } }]
        },
        {
          "name": "Fuerza bruta: sexto intento bloqueado (429)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email_ataque}}\",\n  \"password\": \"Incorrecta1\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Límite por cuenta: 5 intentos de login cada 15 minutos. El script previo hace 5 intentos fallidos contra un email inventado y esta petición (la sexta) recibe 429 con Retry-After."
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "// 5 intentos fallidos seguidos contra una cuenta inventada (no bloquea cuentas reales)",
              "const base = pm.variables.replaceIn('{{base_url}}');",
              "const email = `ataque.${Date.now()}@correo.test`;",
              "pm.collectionVariables.set('email_ataque', email);",
              "pm.sendRequest(base + '/api/sesion', (error, respuesta) => {",
              "    const token = respuesta.json().datos.csrf_token;",
              "    const intento = (quedan) => {",
              "        if (quedan === 0) return;",
              "        pm.sendRequest({",
              "            url: base + '/api/login',",
              "            method: 'POST',",
              "            header: { 'Content-Type': 'application/json', 'X-CSRF-Token': token },",
              "            body: { mode: 'raw', raw: JSON.stringify({ email, password: 'Incorrecta1' }) }",
              "        }, () => intento(quedan - 1));",
              "    };",
              "    intento(5);",
              "});"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('429 Too Many Requests', () => pm.response.to.have.status(429));",
              "pm.test('Cabecera Retry-After', () => pm.response.to.have.header('Retry-After'));"
            ] } }
          ]
        },
        {
          "name": "Cerrar la sesión de administración (204)",
          "request": { "method": "POST", "url": "{{base_url}}/api/logout" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('204 No Content', () => pm.response.to.have.status(204));"
          ] } }]
        }
      ]
    },
