        {
          "name": "Mis pedidos (200)",
          "request": { "method": "GET", "url": "{{base_url}}/api/pedidos?por_pagina=50", "description": "Solo devuelve los pedidos de la clienta de la sesión. Filtro opcional ?estado=pendiente." },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const cuerpo = pm.response.json();",
            "pm.test('Todos son suyos', () => cuerpo.datos.forEach(p => pm.expect(p.cliente.email).to.eql('cliente@kalma.test')));",
            "pm.test('Datos de paginación', () => pm.expect(cuerpo.paginacion).to.have.keys('pagina', 'por_pagina', 'total', 'paginas'));"
          ] } }]
        },
        {
          "name": "Pedido de otro cliente (404, IDOR)",
          "request": { "method": "GET", "url": "{{base_url}}/api/pedidos/SF-2026-000022", "description": "SF-2026-000022 es de otro cliente. Se responde 404 y no 403: así no se confirma que ese código exista." },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
          ] } }]
        },
        {
          "name": "Cantidad no válida (400)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/pedidos",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"lineas\": [ { \"variante_id\": 1, \"cantidad\": 0 }, { \"variante_id\": 2, \"cantidad\": 25 } ]\n}", "options": { "raw": { "language": "json" } } },
            "description": "Cada línea admite de 1 a 20 pares. Los errores llegan por línea para pintarlos junto a cada una."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('Un error por cada línea mal escrita', () => {",
            "    pm.expect(pm.response.json().error.detalles.errores).to.have.keys('lineas.0.cantidad', 'lineas.1.cantidad');",
            "});"
          ] } }]
        },
        {
          "name": "Pedido sin stock suficiente (409)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/pedidos",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{{cuerpo_sin_stock}}", "options": { "raw": { "language": "json" } } },
            "description": "El script previo busca la talla con menos stock y pide una unidad más de las que quedan."
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "pm.sendRequest(pm.variables.replaceIn('{{base_url}}/api/productos/nike-air-force-1-07-cw2288-111'), (error, respuesta) => {",
              "    const talla = respuesta.json().datos.tallas.filter(t => t.stock < 20).sort((a, b) => a.stock - b.stock)[0];",
              "    pm.collectionVariables.set('cuerpo_sin_stock', JSON.stringify({ lineas: [{ variante_id: talla.variante_id, cantidad: talla.stock + 1 }] }));",
              "});"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('Dice qué talla falta y cuánto queda', () => {",
              "    const falta = pm.response.json().error.detalles.sin_stock[0];",
              "    pm.expect(falta.solicitado).to.be.above(falta.disponible);",
              "});"
            ] } }
          ]
        },
        {
          "name": "Crear pedido con dos líneas, una personalizada (201)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/pedidos",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{{cuerpo_pedido}}", "options": { "raw": { "language": "json" } } },
            "description": "POST /api/pedidos · Permiso pedidos.propios. Cuerpo: {direccion_envio?, notas?, lineas: [{variante_id, cantidad, personalizacion?: [{opcion_id, texto?}]}]}. Sin direccion_envio se usa la del perfil. Precio, recargo y total los calcula el servidor. El script previo toma dos tallas con stock y la opción «dorsal» de la ficha."
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "pm.sendRequest(pm.variables.replaceIn('{{base_url}}/api/productos/nike-air-force-1-07-cw2288-111'), (error, respuesta) => {",
              "    const ficha = respuesta.json().datos;",
              "    const tallas = ficha.tallas.filter(t => t.stock >= 2);",
              "    const dorsal = ficha.opciones_personalizacion.find(o => o.tipo === 'dorsal');",
              "    pm.collectionVariables.set('precio', ficha.precio);",
              "    pm.collectionVariables.set('recargo_dorsal', dorsal.recargo);",
              "    pm.collectionVariables.set('variante_1', tallas[0].variante_id);",
              "    pm.collectionVariables.set('stock_antes', tallas[0].stock);",
              "    pm.collectionVariables.set('cuerpo_pedido', JSON.stringify({",
              "        notas: 'Pedido de prueba desde Postman',",
              "        lineas: [",
              "            { variante_id: tallas[0].variante_id, cantidad: 2 },",
              "            { variante_id: tallas[1].variante_id, cantidad: 1, personalizacion: [{ opcion_id: dorsal.id, texto: '10' }] }",
              "        ]",
              "    }));",
              "});"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const pedido = pm.response.json().datos;",
              "pm.collectionVariables.set('codigo_pedido', pedido.codigo);",
              "pm.test('Location apunta al pedido nuevo', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/pedidos/' + pedido.codigo));",
              "pm.test('Pendiente y personalizado', () => {",
              "    pm.expect(pedido.estado).to.eql('pendiente');",
              "    pm.expect(pedido.personalizado).to.be.true;",
              "});",
              "pm.test('Total calculado en el servidor: 2 pares + 1 par con dorsal', () => {",
              "    const precio = Number(pm.collectionVariables.get('precio'));",
              "    const recargo = Number(pm.collectionVariables.get('recargo_dorsal'));",
              "    pm.expect(pedido.total).to.eql(Math.round((2 * precio + precio + recargo) * 100) / 100);",
              "});",
              "pm.sendRequest(pm.variables.replaceIn('{{base_url}}/api/productos/nike-air-force-1-07-cw2288-111'), (error, respuesta) => {",
              "    const variante = Number(pm.collectionVariables.get('variante_1'));",
              "    const talla = respuesta.json().datos.tallas.find(t => t.variante_id === variante);",
              "    pm.test('Stock descontado (2 pares menos)', () => {",
              "        pm.expect(talla.stock).to.eql(Number(pm.collectionVariables.get('stock_antes')) - 2);",
              "    });",
              "});"
            ] } }
          ]
        },
        {
          "name": "Ver el pedido creado (200)",
          "request": { "method": "GET", "url": "{{base_url}}/api/pedidos/{{codigo_pedido}}", "description": "GET /api/pedidos/{codigo} · Detalle con líneas, personalización e historial de estados." },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const pedido = pm.response.json().datos;",
            "pm.test('Dos líneas, la segunda con dorsal', () => {",
            "    pm.expect(pedido.lineas).to.have.lengthOf(2);",
            "    pm.expect(pedido.lineas[1].personalizacion[0].texto).to.eql('10');",
            "});",
            "pm.test('Historial: creado como pendiente', () => pm.expect(pedido.historial[0].estado_nuevo).to.eql('pendiente'));",
            "pm.test('Se puede cancelar', () => pm.expect(pedido.se_puede_cancelar).to.be.true);"
          ] } }]
        },
        {
          "name": "Cancelar un pedido ya enviado (409)",
          "request": { "method": "POST", "url": "{{base_url}}/api/pedidos/SF-2026-000013/cancelar", "description": "SF-2026-000013 es de la clienta pero está enviado: solo se cancela desde pendiente o confirmado." },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
            "pm.test('Indica el estado actual', () => pm.expect(pm.response.json().error.detalles.estado_actual).to.eql('enviado'));"
          ] } }]
        },
        {
          "name": "Cancelar el pedido creado (200)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/pedidos/{{codigo_pedido}}/cancelar",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"motivo\": \"Me equivoqué de talla\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "POST /api/pedidos/{codigo}/cancelar · Cuerpo opcional {motivo}. Es un cambio de estado (queda en el historial) y repone el stock."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Estado cancelado', () => pm.expect(pm.response.json().datos.estado).to.eql('cancelado'));",
            "pm.sendRequest(pm.variables.replaceIn('{{base_url}}/api/productos/nike-air-force-1-07-cw2288-111'), (error, respuesta) => {",
            "    const variante = Number(pm.collectionVariables.get('variante_1'));",
            "    const talla = respuesta.json().datos.tallas.find(t => t.variante_id === variante);",
            "    pm.test('Stock repuesto', () => pm.expect(talla.stock).to.eql(Number(pm.collectionVariables.get('stock_antes'))));",
            "});"
          ] } }]
        },
        {
          "name": "Cancelarlo otra vez (409)",
          "request": { "method": "POST", "url": "{{base_url}}/api/pedidos/{{codigo_pedido}}/cancelar", "description": "Un pedido cancelado no se puede volver a cancelar: el stock se repone una sola vez." },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
          ] } }]
        },
        {
          "name": "Cerrar la sesión de la clienta (204)",
          "request": { "method": "POST", "url": "{{base_url}}/api/logout" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('204 No Content', () => pm.response.to.have.status(204));"
          ] } }]
        }
      ]
    }
